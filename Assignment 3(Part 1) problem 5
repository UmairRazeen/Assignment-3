



Problem 5: Cricket Team Initial Finder
#include<iostream>
using namespace std;

bool searchPlayer(char team[], int size, char target)
{
    for(int i=0; i<size; i++)
    {
        if(team[i] == target)
        {
            return true;
        }
    }

    return false;
}

int main()
{
    char team[11] = {'b','r','s','f','a','h','n','k','m','t','z'};
    char target;

    cout<<"Enter player initial: ";
    cin>>target;

    if(searchPlayer(team,11,target))
    {
        cout<<"Player is in the team";
    }
    else
    {
        cout<<"Player not found";
    }

    return 0;
}

