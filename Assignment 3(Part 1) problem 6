

Problem 6: Word Length Calculator
#include<iostream>
using namespace std;

int findLength(char word[])
{
    int count = 0;

    while(word[count] != '\0')
    {
        count++;
    }

    return count;
}

int main()
{
    char word[50];

    cout<<"Enter a word: ";
    cin>>word;

    cout<<"Length of the word is: "
        <<findLength(word);

    return 0;
}





