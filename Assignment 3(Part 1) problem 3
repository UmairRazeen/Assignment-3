
Problem 3: Custom Power Function
#include<iostream>
using namespace std;

int calculatePower(int base, int exponent)
{
    int power = 1;

    for(int i=1; i<=exponent; i++)
    {
        power = power * base;
    }

    return power;
}

int main()
{
    int base, exponent;

    cout<<"Enter base and exponent: ";
    cin>>base>>exponent;

    cout<<base<<" raised to the power "
        <<exponent<<" is: "
        <<calculatePower(base, exponent);

    return 0;
}

