Problem 1: Average in an Array
#include<iostream>
using namespace std;

double calculateAverage(int marks[], int n)
{
    int sum = 0;

    for(int i=0; i<n; i++)
    {
        sum = sum + marks[i];
    }

    double average = (double)sum / n;

    return average;
}

int main()
{
    int n;

    cout<<"Enter number of students: ";
    cin>>n;

    int marks[n];

    for(int i=0; i<n; i++)
    {
        cout<<"Enter marks: ";
        cin>>marks[i];
    }

    double result = calculateAverage(marks, n);

    cout<<"Average Score = "<<result;

    return 0;
}





