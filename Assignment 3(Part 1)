Problem 1: Average in an Array
#include<iostream>
using namespace std;

double calculateAverage(int marks[], int n)
{
    int sum = 0;

    for(int i=0; i<n; i++)
    {
        sum = sum + marks[i];
    }

    double average = (double)sum / n;

    return average;
}

int main()
{
    int n;

    cout<<"Enter number of students: ";
    cin>>n;

    int marks[n];

    for(int i=0; i<n; i++)
    {
        cout<<"Enter marks: ";
        cin>>marks[i];
    }

    double result = calculateAverage(marks, n);

    cout<<"Average Score = "<<result;

    return 0;
}

Problem 2 : Largest and Smallest values in an Array
#include<iostream>
using namespace std;

int calculateLowest(int arr[], int n)
{
    int low = arr[0];

    for(int i=1; i<n; i++)
    {
        if(arr[i] < low)
        {
            low = arr[i];
        }
    }

    return low;
}

int calculateHighest(int arr[], int n)
{
    int high = arr[0];

    for(int i=1; i<n; i++)
    {
        if(arr[i] > high)
        {
            high = arr[i];
        }
    }

    return high;
}

int main()
{
    int n;

    cout<<"Enter size of array: ";
    cin>>n;

    int arr[n];

    for(int i=0; i<n; i++)
    {
        cin>>arr[i];
    }

    cout<<"Lowest Score = "<<calculateLowest(arr,n)<<endl;
    cout<<"Highest Score = "<<calculateHighest(arr,n);

    return 0;
}

Problem 3: Custom Power Function
#include<iostream>
using namespace std;

int calculatePower(int base, int exponent)
{
    int power = 1;

    for(int i=1; i<=exponent; i++)
    {
        power = power * base;
    }

    return power;
}

int main()
{
    int base, exponent;

    cout<<"Enter base and exponent: ";
    cin>>base>>exponent;

    cout<<base<<" raised to the power "
        <<exponent<<" is: "
        <<calculatePower(base, exponent);

    return 0;
}

Problem 4: Voltage Calculator

#include<iostream>
using namespace std;

double calculateVoltage(double current, double resistance)
{
    return current * resistance;
}

int main()
{
    double current, resistance;

    cout<<"Enter current and resistance: ";
    cin>>current>>resistance;

    double voltage = calculateVoltage(current, resistance);

    cout<<"Total Voltage: "<<voltage<<" V";

    return 0;
}

Problem 5: Cricket Team Initial Finder
#include<iostream>
using namespace std;

bool searchPlayer(char team[], int size, char target)
{
    for(int i=0; i<size; i++)
    {
        if(team[i] == target)
        {
            return true;
        }
    }

    return false;
}

int main()
{
    char team[11] = {'b','r','s','f','a','h','n','k','m','t','z'};
    char target;

    cout<<"Enter player initial: ";
    cin>>target;

    if(searchPlayer(team,11,target))
    {
        cout<<"Player is in the team";
    }
    else
    {
        cout<<"Player not found";
    }

    return 0;
}

Problem 6: Word Length Calculator
#include<iostream>
using namespace std;

int findLength(char word[])
{
    int count = 0;

    while(word[count] != '\0')
    {
        count++;
    }

    return count;
}

int main()
{
    char word[50];

    cout<<"Enter a word: ";
    cin>>word;

    cout<<"Length of the word is: "
        <<findLength(word);

    return 0;
}





