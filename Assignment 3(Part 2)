Program 1:
                      2nd Highest and 2nd Lowest values in an Array
#include <iostream>
using namespace std;

int calculate2Low(int arr[], int n)
{
    int low = arr[0];
    int secondLow = arr[1];

    if(secondLow < low)
    {
        int temp = low;
        low = secondLow;
        secondLow = temp;
    }

    for(int i = 2; i < n; i++)
    {
        if(arr[i] < low)
        {
            secondLow = low;
            low = arr[i];
        }
        else if(arr[i] < secondLow)
        {
            secondLow = arr[i];
        }
    }

    return secondLow;
}

int calculate2High(int arr[], int n)
{
    int high = arr[0];
    int secondHigh = arr[1];

    if(secondHigh > high)
    {
        int temp = high;
        high = secondHigh;
        secondHigh = temp;
    }

    for(int i = 2; i < n; i++)
    {
        if(arr[i] > high)
        {
            secondHigh = high;
            high = arr[i];
        }
        else if(arr[i] > secondHigh)
        {
            secondHigh = arr[i];
        }
    }

    return secondHigh;
}

int main()
{
    int n;
    cin >> n;

    int arr[n];

    for(int i=0; i<n; i++)
        cin >> arr[i];
    cout << "2nd Lowest = " << calculate2Low(arr,n) << endl;
    cout << "2nd Highest = " << calculate2High(arr,n);

    return 0;
}




