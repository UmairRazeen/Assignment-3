Program 2:
                    Sum of an Array
#include <iostream>
using namespace std;

int calculateSum(int arr[], int n)
{
    int sum = 0;

    for(int i=0; i<n; i++)
    {
        sum = sum + arr[i];
    }

    return sum;
}

int main()
{
    int n;
    cin >> n;

    int arr[n];

    for(int i=0; i<n; i++)
        cin >> arr[i];

    cout << "Sum = " << calculateSum(arr,n);

    return 0;
}

