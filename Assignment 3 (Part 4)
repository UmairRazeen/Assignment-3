Problem 1: Sum of All Values in a 2D Array

#include <iostream>
using namespace std;

int main()
{
    int rows, columns;

    cout << "Enter Rows: ";
    cin >> rows;

    cout << "Enter Columns: ";
    cin >> columns;

    int numbers[10][10];
    int totalSum = 0;

    cout << "Enter Elements:" << endl;

    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            cin >> numbers[row][column];
            totalSum += numbers[row][column];
        }
    }

    cout << "Sum of all elements = " << totalSum;

    return 0;
}



Problem 2: Subtract All Values from the First Element 

#include <iostream>
using namespace std;

int main()
{
    int rows, columns;

    cout << "Enter Rows: ";
    cin >> rows;

    cout << "Enter Columns: ";
    cin >> columns;

    int values[10][10];

    cout << "Enter Elements:" << endl;

    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            cin >> values[row][column];
        }
    }

    int result = values[0][0];

    for (int row = 0; row < rows; row++)
    {
        for (int column = 0; column < columns; column++)
        {
            if (!(row == 0 && column == 0))
            {
                result = result - values[row][column];
            }
        }
    }

    cout << "Final Result = " << result;

    return 0;
}




