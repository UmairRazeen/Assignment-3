Problem 4: Bowling Average Calculator 

#include <iostream>
using namespace std;

double getBowlingAverage(int runsConceded, int wicketsTaken)
{
    if (wicketsTaken == 0)
    {
        return 0.0;
    }

    return (double)runsConceded / wicketsTaken;
}

int main()
{
    int runsConceded;
    int wicketsTaken;

    cout << "Enter Runs Conceded: ";
    cin >> runsConceded;

    cout << "Enter Wickets Taken: ";
    cin >> wicketsTaken;

    cout << "Bowling Average: "
         << getBowlingAverage(runsConceded, wicketsTaken);

    return 0;
}


Problem 5: Vertical Word Printer

#include <iostream>
using namespace std;

void printVertical(char word[], int size)
{
    for (int index = 0; index < size; index++)
    {
        if (word[index] == '\0')
        {
            break;
        }

        cout << word[index] << endl;
    }
}

int main()
{
    char word[100];

    cout << "Enter a Word: ";
    cin >> word;

    printVertical(word, 100);

    return 0;
}




Problem 6: Reverse a Word 

#include <iostream>
using namespace std;

void reverseWord(char word[], int size)
{
    int lastIndex = 0;

    while (word[lastIndex] != '\0')
    {
        lastIndex++;
    }

    lastIndex--;

    int firstIndex = 0;

    while (firstIndex < lastIndex)
    {
        char temp = word[firstIndex];
        word[firstIndex] = word[lastIndex];
        word[lastIndex] = temp;

        firstIndex++;
        lastIndex--;
    }
}

int main()
{
    char word[100];

    cout << "Enter a Word: ";
    cin >> word;

    reverseWord(word, 100);

    cout << "Reversed Word: " << word;

    return 0;
}
